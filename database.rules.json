{
  "rules": {
    "profiles": {
      ".read": "auth != null",
      ".indexOn": ["points"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['nick','avatar'])",
        "nick":   { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
        "avatar": { ".validate": "newData.isString() && newData.val().length <= 8" },
        "coins":  { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "games":  { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "wins":   { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "points": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "$other": { ".validate": true }
      }
    },
    "rooms": {
      ".read": "auth != null",
      ".indexOn": ["status"],
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null",
        "chat": {
          "$msg": {
            ".validate": "newData.hasChildren(['uid','text']) && newData.child('text').isString() && newData.child('text').val().length <= 200 && newData.child('text').val().length > 0"
          }
        }
      }
    },
    "worldChat": {
      ".read": "auth != null",
      "$msg": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['uid','text']) && newData.child('uid').val() === auth.uid && newData.child('text').isString() && newData.child('text').val().length <= 200 && newData.child('text').val().length > 0"
      }
    }
  }
}
